LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# Alternative local providers (uncomment to use):
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=qwen/qwen3.6-27b
# LLM_BASE_URL=http://127.0.0.1:8033/v1
# LLM_MODEL=bonsai27b.gguf

# Bundled local model (used when LLM_API_KEY is blank; runs offline on CPU).
# Downloaded once into models/ on first use.
LOCAL_MODEL_PATH=models/qwen2.5-0.5b-instruct-q4_k_m.gguf
LOCAL_MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/main/qwen2.5-0.5b-instruct-q4_k_m.gguf
# 0 = auto (use all available CPU cores)
LOCAL_MODEL_N_THREADS=0
# Max articles to summarize per topic per update run
SUMMARIZE_LIMIT=500
