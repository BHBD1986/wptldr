# LLM provider (OpenRouter). The packaged app ships with a bundled API key
# (api_key.txt) so users don't need to configure anything. For development you
# can override it here:
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-26b-a4b-it
# After this date AI summaries/briefs are disabled (browsing still works).
LICENSE_EXPIRY=2027-04-30

# Max articles to summarize per topic per update run
SUMMARIZE_LIMIT=500
# Topic brief: max articles to include, and batch size for large date ranges
DIGEST_MAX_ITEMS=300
DIGEST_CHUNK_SIZE=40
